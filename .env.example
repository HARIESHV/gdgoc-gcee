# GDGoC GCEE — environment configuration
# Copy this file to `.env.local` (gitignored) and fill in real values,
# or configure the same keys in your Vercel dashboard for production.

# ── MongoDB ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/gdgoc-gcee

# ── Email sending (Resend primary, Gmail SMTP fallback) ───────────────
# Resend: https://resend.com -> API Keys. Required for OTP/verification
# emails in production unless Gmail SMTP below is configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=GDGoC GCEE

# ── Gmail SMTP fallback (use a Gmail App Password, NOT your normal password) ───
# Sign in to your Google Account -> Security -> 2-Step Verification ->
# App passwords -> generate one for "Mail".
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@gdgocgcee.in
ADMIN_PASSWORD=change-me
ADMIN_NAME=GDGoC GCEE Admin

# ── App URLs (used for links inside emails) ──────────────────────────
APP_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ── Optional: force DNS resolvers for Mongo SRV lookups ──────────────
# Set when your system resolver refuses SRV queries (e.g. 8.8.8.8,1.1.1.1).
# FORCE_DNS=

# ── Optional: Google Form webhook shared secret ──────────────────────
# GOOGLE_FORM_WEBHOOK_SECRET=