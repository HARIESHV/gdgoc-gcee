# --- MongoDB ---
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/gdgoc-gcee
# Set FORCE_DNS when the local network DNS refuses SRV lookups (Mongo "querySrv ECONNREFUSED").
# FORCE_DNS=8.8.8.8,1.1.1.1

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# --- App ---
PORT=5000
APP_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# --- Vercel production (set these in the Vercel dashboard, NOT in .env files) ---
# MONGODB_URI   -> your MongoDB Atlas connection string
# JWT_SECRET    -> a long random string
# APP_URL       -> https://<your-frontend-domain>  (used for CORS allowlist + certificate verify links)
# CLIENT_URL    -> https://<your-frontend-domain>  (same as APP_URL when frontend+backend share one Vercel project)
# COOKIE_SECURE -> defaults to true when NODE_ENV=production; leave unset unless you need to override

# --- Initial admin (used only by the seed script) ---
ADMIN_NAME=GDGoC GCEE Admin
ADMIN_EMAIL=admin@gdgocgcee.in
ADMIN_PASSWORD=Admin@123

# --- Gmail SMTP (Nodemailer). Used for OTP, Thank You and Event emails. ---
# Enable 2-Step Verification on the Gmail account, then create an App Password.
# GMAIL_USER=your-gmail@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-gmail-app-password
